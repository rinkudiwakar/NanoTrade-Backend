# ==============================================================================
# NanoTrade Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your real values.
# NEVER commit the .env file — it is in .gitignore.
#
# For production, inject these via your hosting platform's secrets manager
# (e.g. Railway, Render, Docker secrets, GitHub Actions secrets).
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: CORS_ORIGINS=https://app.nanotrade.io,https://staging.nanotrade.io
# Leave empty to block all cross-origin requests (safe default for local dev).
CORS_ORIGINS=

# ── Supabase ──────────────────────────────────────────────────────────────────
# IMPORTANT: Use the SERVICE ROLE key here — NOT the anon key.
# The service role key lets FastAPI bypass Row Level Security for trade writes.
# Keep it backend-only. Never expose it to the browser or frontend code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Simulator Internal Secret ─────────────────────────────────────────────────
# A random shared secret between the Celery simulator and the FastAPI server.
# The simulator sends this as X-Simulator-Secret header on POST /orders/simulator.
# Without this, the endpoint returns 503.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SIMULATOR_SECRET=your-random-simulator-secret-here
