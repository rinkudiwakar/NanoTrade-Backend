# ==========================================
# NanoTrade Backend Configuration template
# Copy this file to '.env' and fill in details
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000

# Supabase Configurations
# Note: FastAPI requires the service_role key to bypass RLS policies and perform matching modifications
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
