# NanoTrade Environment Variables
# Copy this file to .env and fill in the values before running docker-compose

# -------------------------------
# REDIS (Handled by Docker by default)
# -------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------
# SUPABASE SECRETS
# -------------------------------
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# -------------------------------
# SIMULATOR CONFIG
# -------------------------------
SIMULATOR_SECRET=your_simulator_secret_here

# -------------------------------
# APPLICATION CONFIG
# -------------------------------
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (e.g., http://localhost:3000,https://your-frontend.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
